{
  "name": "personal-finance-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "start": "node dist/server.js",
    "dev": "concurrently \"tsx watch src/server.ts\" \"vite\"",
    "test": "npm run build && tsx --test test/**/*.test.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed-owner": "tsx src/database/seed-owner.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^6.4.19",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^8.3.8"
  }
}
