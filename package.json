{
  "name": "personal-finance-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "start": "node dist/server.js",
    "dev": "concurrently \"tsx watch src/server.ts\" \"vite\"",
    "test": "npm run build && tsx --test test/**/*.test.ts",
    "test:browser": "npm run build && playwright test",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed-owner": "tsx src/database/seed-owner.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^6.4.19",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^8.3.8"
  }
}
